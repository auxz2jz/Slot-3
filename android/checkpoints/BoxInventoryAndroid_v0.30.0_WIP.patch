+package com.aiboxinventory.app.sync
+
+import android.util.Base64
+import org.json.JSONObject
+import java.io.BufferedReader
+import java.io.ByteArrayOutputStream
+import java.io.InputStreamReader
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+
+class GitHubApiException(val statusCode: Int, message: String) : Exception(message)
+
+data class RemoteFile(
+    val bytes: ByteArray,
+    val blobSha: String
+)
+
+class GitHubSyncClient(
+    private val config: SyncConfig,
+    private val token: String
+) {
+    fun headCommitSha(): String? {
+        val branch = encode(config.branch)
+        val response = request("GET", "/repos/${config.repositoryFullName}/commits/$branch")
+        if (response.code == 409) return null
+        checkSuccess(response)
+        return JSONObject(response.body).optString("sha").takeIf { it.isNotBlank() }
+    }
+
+    fun getFile(path: String): RemoteFile? {
+        val response = request(
+            "GET",
+            "/repos/${config.repositoryFullName}/contents/${encodePath(path)}?ref=${encode(config.branch)}"
+        )
+        if (response.code == 404) return null
+        checkSuccess(response)
+        val json = JSONObject(response.body)
+        val encoding = json.optString("encoding")
+        val bytes = if (encoding.equals("base64", ignoreCase = true)) {
+            val content = json.optString("content").replace("\n", "")
+            Base64.decode(content, Base64.DEFAULT)
+        } else {
+            // GitHub omits inline base64 content for larger files. Request the same
+            // Contents endpoint using the raw media type instead of treating that
+            // normal response as an unsupported sync file.
+            requestRaw(
+                "/repos/${config.repositoryFullName}/contents/${encodePath(path)}?ref=${encode(config.branch)}"
+            )
+        }
+        return RemoteFile(
+            bytes = bytes,
+            blobSha = json.getString("sha")
+        )
+    }
+
+    fun putFile(path: String, bytes: ByteArray, message: String, existingBlobSha: String? = null) {
+        val body = JSONObject()
+            .put("message", message)
+            .put("content", Base64.encodeToString(bytes, Base64.NO_WRAP))
+            .put("branch", config.branch)
+        existingBlobSha?.takeIf { it.isNotBlank() }?.let { body.put("sha", it) }
+        val response = request(
+            "PUT",
+            "/repos/${config.repositoryFullName}/contents/${encodePath(path)}",
+            body.toString()
+        )
+        checkSuccess(response)
+    }
+
+    private fun requestRaw(path: String): ByteArray {
+        val connection = (URL("https://api.github.com$path").openConnection() as HttpURLConnection).apply {
+            requestMethod = "GET"
+            connectTimeout = 15_000
+            readTimeout = 60_000
+            setRequestProperty("Accept", "application/vnd.github.raw+json")
+            setRequestProperty("X-GitHub-Api-Version", "2022-11-28")
+            setRequestProperty("User-Agent", "BoxInventory-Android")
+            setRequestProperty("Authorization", "Bearer $token")
+        }
+        return try {
+            val code = connection.responseCode
+            if (code !in 200..299) {
+                val text = connection.errorStream?.use { input ->
+                    BufferedReader(InputStreamReader(input, Charsets.UTF_8)).readText()
+                }.orEmpty()
+                checkSuccess(HttpResponse(code, text))
+            }
+            connection.inputStream.use { input ->
+                val output = ByteArrayOutputStream()
+                val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read <= 0) break
+                    output.write(buffer, 0, read)
+                }
+                output.toByteArray()
+            }
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private data class HttpResponse(val code: Int, val body: String)
+
+    private fun request(method: String, path: String, body: String? = null): HttpResponse {
+        val connection = (URL("https://api.github.com$path").openConnection() as HttpURLConnection).apply {
+            requestMethod = method
+            connectTimeout = 15_000
+            readTimeout = 45_000
+            setRequestProperty("Accept", "application/vnd.github+json")
+            setRequestProperty("X-GitHub-Api-Version", "2022-11-28")
+            setRequestProperty("User-Agent", "BoxInventory-Android")
+            setRequestProperty("Authorization", "Bearer $token")
+            if (body != null) {
+                doOutput = true
+                setRequestProperty("Content-Type", "application/json; charset=utf-8")
+            }
+        }
+        return try {
+            if (body != null) {
+                connection.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            }
+            val code = connection.responseCode
+            val stream = if (code in 200..299) connection.inputStream else connection.errorStream
+            val text = stream?.use { input ->
+                BufferedReader(InputStreamReader(input, Charsets.UTF_8)).readText()
+            }.orEmpty()
+            HttpResponse(code, text)
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun checkSuccess(response: HttpResponse) {
+        if (response.code in 200..299) return
+        val message = runCatching { JSONObject(response.body).optString("message") }.getOrNull()
+            ?.takeIf { it.isNotBlank() }
+            ?: "GitHub request failed."
+        throw GitHubApiException(response.code, "GitHub ${response.code}: $message")
+    }
+
+    private fun encode(value: String): String =
+        URLEncoder.encode(value, Charsets.UTF_8.name()).replace("+", "%20")
+
+    private fun encodePath(path: String): String =
+        path.split('/').joinToString("/") { encode(it) }
+}
