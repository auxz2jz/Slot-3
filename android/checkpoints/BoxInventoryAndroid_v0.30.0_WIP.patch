+class InventorySyncService(
+    private val context: Context,
+    private val repository: AppRepository
+) {
+    private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private val tokenStore = SecureTokenStore(context)
+    private val mutex = Mutex()
+
+    private val _state = MutableStateFlow(loadInitialState())
+    val state = _state.asStateFlow()
+
+    data class PreparedMedia(
+        val sha256: String,
+        val file: File,
+        val relativePath: String,
+        val sizeBytes: Long,
+        val mimeType: String
+    )
+
+    data class LocalSnapshot(
+        val root: JSONObject,
+        val bytes: ByteArray,
+        val dataHash: String,
+        val media: List<PreparedMedia>
+    )
+
+    data class RemoteSnapshot(
+        val root: JSONObject,
+        val blobSha: String,
+        val dataHash: String,
+        val mediaPaths: Map<String, String>
+    )
+
+    fun repositoryFullName(): String = prefs.getString(KEY_REPOSITORY, "").orEmpty()
+    fun branch(): String = prefs.getString(KEY_BRANCH, DEFAULT_BRANCH).orEmpty().ifBlank { DEFAULT_BRANCH }
+    fun hasToken(): Boolean = tokenStore.hasToken()
+
+    fun saveConfiguration(repositoryFullName: String, branch: String, token: String = "") {
+        val repo = repositoryFullName.trim()
+        val cleanBranch = branch.trim().ifBlank { DEFAULT_BRANCH }
+        require(REPOSITORY_REGEX.matches(repo)) { "Enter the GitHub repository as owner/repository." }
+        val oldRepo = this.repositoryFullName()
+        val oldBranch = this.branch()
+        val changedTarget = oldRepo != repo || oldBranch != cleanBranch
+        prefs.edit()
+            .putString(KEY_REPOSITORY, repo)
+            .putString(KEY_BRANCH, cleanBranch)
+            .apply()
+        if (token.isNotBlank()) tokenStore.save(token)
+        if (changedTarget) clearAnchors()
+        _state.value = SyncUiState(
+            phase = SyncPhase.READY,
+            repositoryFullName = repo,
+            branch = cleanBranch,
+            hasToken = tokenStore.hasToken(),
+            lastSuccessAt = prefs.getLong(KEY_LAST_SUCCESS, 0L),
+            lastRemoteCommit = prefs.getString(KEY_LAST_COMMIT, "").orEmpty(),
+            message = if (tokenStore.hasToken()) "Sync settings saved." else "Repository saved. Add a GitHub token before syncing."
+        )
+    }
+
+    fun clearToken() {
+        tokenStore.clear()
+        _state.value = _state.value.copy(
+            phase = if (repositoryFullName().isBlank()) SyncPhase.UNCONFIGURED else SyncPhase.READY,
+            hasToken = false,
+            message = "Saved GitHub token cleared."
+        )
+    }
+
+    fun clearConfiguration() {
+        prefs.edit()
+            .remove(KEY_REPOSITORY)
+            .remove(KEY_BRANCH)
+            .apply()
+        tokenStore.clear()
+        clearAnchors()
+        _state.value = SyncUiState()
+    }
+
+    suspend fun syncNow(resolution: SyncResolution? = null) = mutex.withLock {
+        val config = currentConfig()
+        val token = tokenStore.load()
+        if (config == null || token.isNullOrBlank()) {
+            _state.value = SyncUiState(
+                phase = SyncPhase.UNCONFIGURED,
+                repositoryFullName = repositoryFullName(),
+                branch = branch(),
+                hasToken = !token.isNullOrBlank(),
+                lastSuccessAt = prefs.getLong(KEY_LAST_SUCCESS, 0L),
+                lastRemoteCommit = prefs.getString(KEY_LAST_COMMIT, "").orEmpty(),
+                message = "Configure a private GitHub repository and token before syncing."
+            )
+            return@withLock
+        }
+
+        _state.value = _state.value.copy(
+            phase = SyncPhase.SYNCING,
+            repositoryFullName = config.repositoryFullName,
+            branch = config.branch,
+            hasToken = true,
+            message = "Checking GitHub for inventory changes…"
+        )
+
+        runCatching {
+            withContext(Dispatchers.IO) {
+                val client = GitHubSyncClient(config, token)
+                val local = buildLocalSnapshot()
+                val remoteHead = client.headCommitSha()
+                val lastHash = prefs.getString(KEY_LAST_HASH, "").orEmpty()
+                val lastCommit = prefs.getString(KEY_LAST_COMMIT, "").orEmpty()
+
+                // Fast no-op path: if our logical data hash and the remote branch head
+                // are both exactly what we recorded at the last successful sync, do
+                // not download snapshot.json or any media again.
+                if (lastHash.isNotBlank() && local.dataHash == lastHash && remoteHead == lastCommit) {
+                    _state.value = currentState(
+                        SyncPhase.SYNCED,
+                        "Already up to date — only the lightweight GitHub revision check was needed.",
+                        localChanged = false,
+                        remoteChanged = false,
+                        commit = lastCommit
+                    )
+                    return@withContext
+                }
+
+                val remote = loadRemoteSnapshot(client)
+
+                if (lastHash.isBlank()) {
+                    when {
+                        remote == null -> pushLocal(client, local, null)
+                        resolution == SyncResolution.USE_REMOTE -> pullRemote(client, remote, remoteHead)
+                        resolution == SyncResolution.KEEP_LOCAL -> pushLocal(client, local, remote)
+                        else -> {
+                            _state.value = currentState(
+                                SyncPhase.FIRST_SYNC_REQUIRED,
+                                "This GitHub repository already has an Inventory Box snapshot. Choose which inventory should be used for the first sync.",
+                                localChanged = true,
+                                remoteChanged = true,
+                                remoteSnapshotAvailable = true
+                            )
+                        }
+                    }
+                    return@withContext
+                }
+
+                if (remote == null) {
+                    if (resolution == SyncResolution.KEEP_LOCAL) {
+                        pushLocal(client, local, null)
+                    } else {
+                        _state.value = currentState(
+                            SyncPhase.CONFLICT,
+                            "The remote Inventory Box snapshot is missing. Nothing was overwritten. Choose Keep this device to recreate it, or fix the GitHub repository first.",
+                            localChanged = local.dataHash != lastHash,
+                            remoteChanged = true,
+                            remoteSnapshotAvailable = false
+                        )
+                    }
+                    return@withContext
+                }
+
+                val localChanged = local.dataHash != lastHash
+                val remoteChanged = remote.dataHash != lastHash
+
+                when {
+                    localChanged && remoteChanged && resolution == null -> {
+                        _state.value = currentState(
+                            SyncPhase.CONFLICT,
+                            "Both this device and GitHub changed since the last successful sync. Nothing was overwritten.",
+                            localChanged = true,
+                            remoteChanged = true,
+                            remoteSnapshotAvailable = true
+                        )
+                    }
+                    localChanged && remoteChanged && resolution == SyncResolution.USE_REMOTE ->
+                        pullRemote(client, remote, remoteHead)
+                    localChanged && remoteChanged && resolution == SyncResolution.KEEP_LOCAL ->
+                        pushLocal(client, local, remote)
+                    remoteChanged -> pullRemote(client, remote, remoteHead)
+                    localChanged -> pushLocal(client, local, remote)
+                    else -> {
+                        val resolvedCommit = remoteHead ?: lastCommit
+                        prefs.edit().putString(KEY_LAST_COMMIT, resolvedCommit).apply()
+                        _state.value = currentState(
+                            SyncPhase.SYNCED,
+                            "Already up to date — no inventory or photo transfer was needed.",
+                            localChanged = false,
+                            remoteChanged = false,
+                            commit = resolvedCommit
+                        )
+                    }
+                }
+            }
+        }.onFailure { error ->
+            _state.value = currentState(
+                SyncPhase.ERROR,
+                safeErrorMessage(error),
+                localChanged = _state.value.localChanged,
+                remoteChanged = _state.value.remoteChanged
+            )
+        }
+    }
+
+    private suspend fun pushLocal(
+        client: GitHubSyncClient,
+        local: LocalSnapshot,
+        remote: RemoteSnapshot?
+    ) {
+        ensureProtocol(client)
+        val remoteMedia = remote?.mediaPaths?.keys.orEmpty()
+        local.media.forEachIndexed { index, media ->
+            if (media.sha256 in remoteMedia) return@forEachIndexed
+            val existing = client.getFile(media.relativePath)
+            if (existing == null) {
+                client.putFile(
+                    media.relativePath,
+                    media.file.readBytes(),
+                    "inventory-sync: add media ${media.sha256.take(12)}"
+                )
+            } else {
+                val existingHash = sha256Hex(existing.bytes)
+                require(existingHash == media.sha256) {
+                    "Remote media path ${media.relativePath} does not match its SHA-256 name."
+                }
+            }
+            _state.value = _state.value.copy(
+                message = "Uploading inventory photos… ${index + 1}/${local.media.size}"
+            )
+        }
+
+        // Re-check the snapshot object immediately before publishing. Media uploads
+        // create their own commits, but they do not change snapshot.json. If another
+        // client changed or created the snapshot while we were uploading media, stop
+        // instead of silently replacing that client's inventory.
+        val currentSnapshot = client.getFile(SNAPSHOT_PATH)
+        when {
+            remote == null && currentSnapshot != null ->
+                throw GitHubApiException(409, "The GitHub inventory changed during sync. Run Sync now again.")
+            remote != null && currentSnapshot?.blobSha != remote.blobSha ->
+                throw GitHubApiException(409, "The GitHub inventory changed during sync. Run Sync now again.")
+        }
+        client.putFile(
+            SNAPSHOT_PATH,
+            local.bytes,
+            "inventory-sync: publish snapshot ${local.root.optString("snapshotId").take(8)}",
+            remote?.blobSha
+        )
+
+        val verified = loadRemoteSnapshot(client)
+            ?: error("GitHub did not return the snapshot after upload.")
+        require(verified.dataHash == local.dataHash) {
+            "The GitHub snapshot changed during upload. Run sync again before making more changes."
+        }
+        val finalHead = client.headCommitSha().orEmpty()
+        recordSuccess(local.dataHash, finalHead)
+        _state.value = currentState(
+            SyncPhase.SYNCED,
+            "Synced this device to GitHub.",
+            localChanged = false,
+            remoteChanged = false,
+            commit = finalHead
+        )
+    }
+
+    private suspend fun pullRemote(
+        client: GitHubSyncClient,
+        remote: RemoteSnapshot,
+        remoteHead: String?
+    ) {
+        _state.value = _state.value.copy(message = "Downloading the shared inventory…")
+        applyRemoteSnapshot(client, remote)
+        val rebuilt = buildLocalSnapshot()
+        require(rebuilt.dataHash == remote.dataHash) {
+            "The downloaded snapshot could not be reproduced locally. No automatic upload will be attempted."
+        }
+        val anchoredHead = remoteHead ?: client.headCommitSha().orEmpty()
+        recordSuccess(remote.dataHash, anchoredHead)
+        val newestHead = client.headCommitSha().orEmpty()
+        val message = if (newestHead.isNotBlank() && newestHead != anchoredHead) {
+            "Downloaded the GitHub inventory. Another remote change arrived during sync; Sync now will pick it up."
+        } else {
+            "Downloaded the latest GitHub inventory."
+        }
+        _state.value = currentState(
+            SyncPhase.SYNCED,
+            message,
+            localChanged = false,
+            remoteChanged = newestHead.isNotBlank() && newestHead != anchoredHead,
+            commit = anchoredHead
+        )
+    }
+
+    private fun ensureProtocol(client: GitHubSyncClient) {
+        val existing = client.getFile(PROTOCOL_PATH)
+        if (existing == null) {
+            val protocol = JSONObject()
+                .put("product", PRODUCT)
+                .put("protocolVersion", PROTOCOL_VERSION)
+                .put("snapshotSchemaVersion", SNAPSHOT_SCHEMA_VERSION)
+                .toString(2)
+                .toByteArray(Charsets.UTF_8)
+            client.putFile(PROTOCOL_PATH, protocol, "inventory-sync: initialize protocol v$PROTOCOL_VERSION")
+        } else {
+            validateProtocol(JSONObject(String(existing.bytes, Charsets.UTF_8)))
+        }
+    }
+
+    private fun loadRemoteSnapshot(client: GitHubSyncClient): RemoteSnapshot? {
+        val protocolFile = client.getFile(PROTOCOL_PATH)
+        val snapshotFile = client.getFile(SNAPSHOT_PATH)
+        if (snapshotFile == null) {
+            protocolFile?.let { validateProtocol(JSONObject(String(it.bytes, Charsets.UTF_8))) }
+            return null
+        }
+        require(protocolFile != null) { "GitHub has an Inventory Box snapshot but protocol.json is missing." }
+        validateProtocol(JSONObject(String(protocolFile.bytes, Charsets.UTF_8)))
+
+        val root = JSONObject(String(snapshotFile.bytes, Charsets.UTF_8))
+        validateSnapshotEnvelope(root)
+        val logical = logicalObject(root)
+        val calculated = sha256Hex(canonicalJson(logical).toByteArray(Charsets.UTF_8))
+        val declared = root.getString("dataHash")
+        require(calculated == declared) { "GitHub snapshot dataHash validation failed." }
+
+        val mediaPaths = mutableMapOf<String, String>()
+        val media = root.optJSONArray("media") ?: JSONArray()
+        for (i in 0 until media.length()) {
+            val m = media.getJSONObject(i)
+            val sha = m.optString("sha256")
+            val path = m.optString("relativePath")
+            if (sha.matches(SHA_REGEX) && path.isNotBlank()) mediaPaths[sha] = path
+        }
+        return RemoteSnapshot(root, snapshotFile.blobSha, declared, mediaPaths)
+    }
+
+    private suspend fun buildLocalSnapshot(): LocalSnapshot {
+        val boxes = repository.allBoxes().sortedBy { it.id }
+        val items = repository.allItems().sortedBy { it.id }
+        val itemPhotos = repository.allItemPhotos().sortedBy { it.id }
+        val routes = repository.allLearnedRoutes().sortedBy { it.normalizedName }
+        val custom = repository.allCustomCategories().sortedBy { it.id }
+        val aliases = repository.allCategoryAliases().sortedBy { it.id }
+        val moves = repository.allMoveHistory().sortedBy { it.id }
+        val shopping = repository.allShoppingItems().sortedBy { it.id }
+
+        val mediaBySha = linkedMapOf<String, PreparedMedia>()
+        fun mediaSha(path: String): String {
+            if (path.isBlank()) return ""
+            val file = File(path)
+            if (!file.exists() || file.length() <= 0L) return ""
+            require(file.length() <= MAX_SYNC_MEDIA_BYTES) {
+                "A photo is too large for GitHub sync (${file.length() / 1024 / 1024} MB). Create a smaller copy before syncing."
+            }
+            val sha = cachedFileSha(file)
+            val (mimeType, extension) = detectImageType(file)
+            mediaBySha.putIfAbsent(
+                sha,
+                PreparedMedia(
+                    sha256 = sha,
+                    file = file,
+                    relativePath = "$MEDIA_DIR/$sha.$extension",
+                    sizeBytes = file.length(),
+                    mimeType = mimeType
+                )
+            )
+            return sha
+        }
+
+        val boxesJson = JSONArray()
+        boxes.forEach { box ->
+            val routing = BoxRouting.parse(box.description)
+            boxesJson.put(JSONObject()
+                .put("id", box.id)
+                .put("number", box.number)
+                .put("name", box.name)
+                .put("userDescription", routing.userDescription)
+                .put("routingMode", if (routing.manualCategory == null) "AUTO" else "MANUAL_CATEGORY")
+                .put("manualCategory", routing.manualCategory ?: "")
+                .put("qrValue", box.qrValue)
+                .put("capacityStatus", BoxCapacity.normalized(box))
+                .put("locationName", box.locationName)
+                .put("areaName", box.areaName))
+        }
+
+        val itemsJson = JSONArray()
+        items.forEach { item ->
+            val refs = JSONObject()
+                .put("primary", mediaSha(item.labeledPhotoPath))
+                .put("original", mediaSha(item.originalPhotoPath))
+                .put("reference", mediaSha(item.referencePhotoPath))
+            itemsJson.put(JSONObject()
+                .put("id", item.id)
+                .put("name", item.name)
+                .put("normalizedName", item.normalizedName)
+                .put("category", item.category)
+                .put("boxId", item.boxId)
+                .put("note", item.note)
+                .put("description", item.description)
+                .put("quantity", item.quantity)
+                .put("createdAt", item.createdAt)
+                .put("aiPrimaryLabel", item.aiPrimaryLabel)
+                .put("aiConfidence", "%.6f".format(java.util.Locale.US, item.aiConfidence))
+                .put("aiCandidates", item.aiCandidates)
+                .put("recognitionSource", item.recognitionSource)
+                .putNullable("cropLeft", item.cropLeft)
+                .putNullable("cropTop", item.cropTop)
+                .putNullable("cropRight", item.cropRight)
+                .putNullable("cropBottom", item.cropBottom)
+                .put("productBarcode", item.productBarcode)
+                .put("productBrand", item.productBrand)
+                .put("productDescription", item.productDescription)
+                .put("productSource", item.productSource)
+                .put("referenceSourceUrl", item.referenceSourceUrl)
+                .put("itemStatus", item.itemStatus)
+                .put("statusNote", item.statusNote)
+                .put("isFavorite", item.isFavorite)
+                .put("serialNumber", item.serialNumber)
+                .put("modelNumber", item.modelNumber)
+                .put("purchasePriceCents", item.purchasePriceCents)
+                .put("purchaseStore", item.purchaseStore)
+                .put("purchaseDate", item.purchaseDate)
+                .put("warrantyExpiration", item.warrantyExpiration)
+                .put("warrantyNote", item.warrantyNote)
+                .put("isArchived", item.isArchived)
+                .put("archivedAt", item.archivedAt)
+                .put("mediaRefs", refs))
+        }
+
+        val photosJson = JSONArray()
+        itemPhotos.forEach { photo ->
+            val sha = mediaSha(photo.photoPath)
+            // A database row whose backing photo file is already gone cannot be
+            // reproduced on another platform. Exclude that orphaned photo row from
+            // the portable snapshot so a pull can rebuild the same logical hash.
+            if (sha.isNotBlank()) {
+                photosJson.put(JSONObject()
+                    .put("id", photo.id)
+                    .put("itemId", photo.itemId)
+                    .put("position", photo.position)
+                    .put("createdAt", photo.createdAt)
+                    .put("mediaSha", sha))
+            }
+        }
+
+        val routesJson = JSONArray()
+        routes.forEach { route -> routesJson.put(JSONObject()
+            .put("normalizedName", route.normalizedName)
+            .put("boxId", route.boxId)
+            .put("updatedAt", route.updatedAt)) }
+
+        val customJson = JSONArray()
+        custom.forEach { c -> customJson.put(JSONObject()
+            .put("id", c.id).put("name", c.name).put("createdAt", c.createdAt)) }
+
+        val aliasesJson = JSONArray()
+        aliases.forEach { a -> aliasesJson.put(JSONObject()
+            .put("id", a.id).put("alias", a.alias).put("category", a.category).put("createdAt", a.createdAt)) }
+
+        val movesJson = JSONArray()
+        moves.forEach { move -> movesJson.put(JSONObject()
+            .put("id", move.id)
+            .put("itemId", move.itemId)
+            .put("fromBoxId", move.fromBoxId)
+            .put("toBoxId", move.toBoxId)
+            .put("movedAt", move.movedAt)
+            .put("reason", move.reason)) }
++        val shoppingJson = JSONArray()
+        shopping.forEach { item -> shoppingJson.put(JSONObject()
+            .put("id", item.id)
+            .put("name", item.name)
+            .put("normalizedName", item.normalizedName)
+            .put("quantity", item.quantity)
+            .put("note", item.note)
+            .put("store", item.store)
+            .put("priority", item.priority)
+            .put("purchased", item.purchased)
+            .put("createdAt", item.createdAt)
+            .put("updatedAt", item.updatedAt)) }
+
+        val mediaJson = JSONArray()
+        mediaBySha.values.sortedBy { it.sha256 }.forEach { media ->
+            mediaJson.put(JSONObject()
+                .put("sha256", media.sha256)
+                .put("relativePath", media.relativePath)
+                .put("mimeType", media.mimeType)
+                .put("sizeBytes", media.sizeBytes))
+        }
+
+        val logical = JSONObject()
+            .put("boxes", boxesJson)
+            .put("items", itemsJson)
+            .put("itemPhotos", photosJson)
+            .put("learnedRoutes", routesJson)
+            .put("customCategories", customJson)
+            .put("categoryAliases", aliasesJson)
+            .put("moveHistory", movesJson)
+            .put("shoppingItems", shoppingJson)
+            .put("media", mediaJson)
+
+        val dataHash = sha256Hex(canonicalJson(logical).toByteArray(Charsets.UTF_8))
+        val root = JSONObject()
+            .put("product", PRODUCT)
+            .put("protocolVersion", PROTOCOL_VERSION)
+            .put("snapshotSchemaVersion", SNAPSHOT_SCHEMA_VERSION)
+            .put("snapshotId", UUID.randomUUID().toString())
+            .put("generatedAtUtc", Instant.now().toString())
+            .put("sourceDeviceId", deviceId())
+            .put("dataHash", dataHash)
+            .put("boxes", boxesJson)
+            .put("items", itemsJson)
+            .put("itemPhotos", photosJson)
+            .put("learnedRoutes", routesJson)
+            .put("customCategories", customJson)
+            .put("categoryAliases", aliasesJson)
+            .put("moveHistory", movesJson)
+            .put("shoppingItems", shoppingJson)
+            .put("media", mediaJson)
+
+        val bytes = root.toString(2).toByteArray(Charsets.UTF_8)
+        return LocalSnapshot(root, bytes, dataHash, mediaBySha.values.toList())
+    }
+
+    private suspend fun applyRemoteSnapshot(client: GitHubSyncClient, remote: RemoteSnapshot) {
+        val root = remote.root
+        val boxes = mutableListOf<BoxEntity>()
+        val items = mutableListOf<InventoryItemEntity>()
+        val itemPhotos = mutableListOf<ItemPhotoEntity>()
+        val routes = mutableListOf<LearnedRouteEntity>()
+        val custom = mutableListOf<CustomCategoryEntity>()
+        val aliases = mutableListOf<CategoryAliasEntity>()
+        val moves = mutableListOf<MoveHistoryEntity>()
+        val shopping = mutableListOf<ShoppingItemEntity>()
+        val stagingDir = File(context.cacheDir, "inventory-sync-${UUID.randomUUID()}").apply { mkdirs() }
+        val stagedBySha = mutableMapOf<String, File>()
+
+        try {
+        val boxesArray = root.getJSONArray("boxes")
+        for (i in 0 until boxesArray.length()) {
+            val o = boxesArray.getJSONObject(i)
+            val manual = o.optString("manualCategory").trim()
+            val userDescription = o.optString("userDescription")
+            val description = if (o.optString("routingMode") == "MANUAL_CATEGORY" && manual.isNotBlank()) {
+                BoxRouting.encodeManual(manual, userDescription)
+            } else {
+                BoxRouting.encodeAutomatic(userDescription)
+            }
+            val capacity = o.optString("capacityStatus", BoxCapacity.AVAILABLE)
+                .takeIf { it in BoxCapacity.levels } ?: BoxCapacity.AVAILABLE
+            boxes += BoxEntity(
+                id = o.getString("id"),
+                number = o.optInt("number", i + 1),
+                name = o.optString("name", "Box ${i + 1}"),
+                description = description,
+                qrValue = o.optString("qrValue").ifBlank { "BOXINV:${o.getString("id")}" },
+                isFull = capacity == BoxCapacity.FULL,
+                capacityStatus = capacity,
+                locationName = o.optString("locationName"),
+                areaName = o.optString("areaName")
+            )
+        }
+
+        val itemsArray = root.getJSONArray("items")
+        for (i in 0 until itemsArray.length()) {
+            val o = itemsArray.getJSONObject(i)
+            val id = o.getString("id")
+            val refs = o.optJSONObject("mediaRefs") ?: JSONObject()
+            val primary = materializeMedia(client, remote, refs.optString("primary"), "primary-$id", stagingDir, stagedBySha)
+            val original = materializeMedia(client, remote, refs.optString("original"), "original-$id", stagingDir, stagedBySha)
+            val reference = materializeMedia(client, remote, refs.optString("reference"), "reference-$id", stagingDir, stagedBySha)
+            items += InventoryItemEntity(
+                id = id,
+                name = o.optString("name"),
+                normalizedName = o.optString("normalizedName").ifBlank { normalize(o.optString("name")) },
+                category = o.optString("category"),
+                boxId = o.optString("boxId"),
+                note = o.optString("note"),
+                description = o.optString("description"),
+                quantity = o.optInt("quantity", 1).coerceAtLeast(1),
+                createdAt = o.optLong("createdAt", System.currentTimeMillis()),
+                labeledPhotoPath = primary,
+                originalPhotoPath = original,
+                aiPrimaryLabel = o.optString("aiPrimaryLabel"),
+                aiConfidence = o.optString("aiConfidence", "0").toFloatOrNull() ?: 0f,
+                aiCandidates = o.optString("aiCandidates"),
+                recognitionSource = o.optString("recognitionSource"),
+                cropLeft = o.optNullableInt("cropLeft"),
+                cropTop = o.optNullableInt("cropTop"),
+                cropRight = o.optNullableInt("cropRight"),
+                cropBottom = o.optNullableInt("cropBottom"),
+                productBarcode = o.optString("productBarcode"),
+                productBrand = o.optString("productBrand"),
+                productDescription = o.optString("productDescription"),
+                productSource = o.optString("productSource"),
+                referencePhotoPath = reference,
+                referenceSourceUrl = o.optString("referenceSourceUrl"),
+                itemStatus = o.optString("itemStatus", InventoryStatus.IN_BOX)
+                    .takeIf { it in InventoryStatus.values } ?: InventoryStatus.IN_BOX,
+                statusNote = o.optString("statusNote"),
+                isFavorite = o.optBoolean("isFavorite", false),
+                serialNumber = o.optString("serialNumber"),
+                modelNumber = o.optString("modelNumber"),
+                purchasePriceCents = o.optLong("purchasePriceCents", 0L),
+                purchaseStore = o.optString("purchaseStore"),
+                purchaseDate = o.optLong("purchaseDate", 0L),
+                warrantyExpiration = o.optLong("warrantyExpiration", 0L),
+                warrantyNote = o.optString("warrantyNote"),
+                isArchived = o.optBoolean("isArchived", false),
+                archivedAt = o.optLong("archivedAt", 0L)
+            )
+        }
+
+        val photosArray = root.getJSONArray("itemPhotos")
+        for (i in 0 until photosArray.length()) {
+            val o = photosArray.getJSONObject(i)
+            val id = o.getString("id")
+            val path = materializeMedia(client, remote, o.optString("mediaSha"), "additional-$id", stagingDir, stagedBySha)
+            if (path.isNotBlank()) {
+                itemPhotos += ItemPhotoEntity(
+                    id = id,
+                    itemId = o.getString("itemId"),
+                    photoPath = path,
+                    position = o.optInt("position", i),
+                    createdAt = o.optLong("createdAt", System.currentTimeMillis())
+                )
+            }
+        }
+
+        val routesArray = root.getJSONArray("learnedRoutes")
+        for (i in 0 until routesArray.length()) {
+            val o = routesArray.getJSONObject(i)
+            routes += LearnedRouteEntity(o.getString("normalizedName"), o.getString("boxId"), o.optLong("updatedAt"))
+        }
+
+        val customArray = root.getJSONArray("customCategories")
+        for (i in 0 until customArray.length()) {
+            val o = customArray.getJSONObject(i)
+            custom += CustomCategoryEntity(o.getString("id"), o.getString("name"), o.optLong("createdAt"))
+        }
+
+        val aliasesArray = root.getJSONArray("categoryAliases")
+        for (i in 0 until aliasesArray.length()) {
+            val o = aliasesArray.getJSONObject(i)
+            aliases += CategoryAliasEntity(o.getString("id"), o.getString("alias"), o.getString("category"), o.optLong("createdAt"))
+        }
+
+        val movesArray = root.getJSONArray("moveHistory")
+        for (i in 0 until movesArray.length()) {
+            val o = movesArray.getJSONObject(i)
+            moves += MoveHistoryEntity(
+                id = o.getString("id"),
+                itemId = o.getString("itemId"),
+                fromBoxId = o.getString("fromBoxId"),
+                toBoxId = o.getString("toBoxId"),
+                movedAt = o.optLong("movedAt"),
+                reason = o.optString("reason", "Moved")
+            )
+        }
+
+        val shoppingArray = root.getJSONArray("shoppingItems")
+        for (i in 0 until shoppingArray.length()) {
+            val o = shoppingArray.getJSONObject(i)
+            shopping += ShoppingItemEntity(
+                id = o.getString("id"),
+                name = o.getString("name"),
+                normalizedName = o.optString("normalizedName").ifBlank { normalize(o.getString("name")) },
+                quantity = o.optInt("quantity", 1).coerceAtLeast(1),
+                note = o.optString("note"),
+                store = o.optString("store"),
+                priority = o.optString("priority", "Normal"),
+                purchased = o.optBoolean("purchased", false),
+                createdAt = o.optLong("createdAt", System.currentTimeMillis()),
+                updatedAt = o.optLong("updatedAt", System.currentTimeMillis())
+            )
+        }
+
+        repository.replaceAll(boxes, items, routes, custom, aliases, moves, shopping, itemPhotos)
+        } finally {
+            stagingDir.deleteRecursively()
+        }
+    }
+
+    private fun materializeMedia(
+        client: GitHubSyncClient,
+        remote: RemoteSnapshot,
+        sha: String,
+        targetKey: String,
+        stagingDir: File,
+        stagedBySha: MutableMap<String, File>
+    ): String {
+        if (!sha.matches(SHA_REGEX)) return ""
+
+        // Remote imports use their own permanent files rather than overwriting the
+        // Android paths that the currently-active local database may still reference.
+        // If a pull fails before the database transaction, the old inventory/photos
+        // therefore remain intact; at worst an unused imported file is left behind.
+        val safeKey = targetKey.replace(Regex("[^A-Za-z0-9_.-]"), "_")
+        val importDir = File(context.filesDir, "inventory/sync_import").apply { mkdirs() }
+        val target = File(importDir, "$safeKey-$sha.jpg")
+        if (target.exists() && target.length() > 0L && cachedFileSha(target) == sha) {
+            return target.absolutePath
+        }
+
+        val staged = stagedBySha.getOrPut(sha) {
+            val remotePath = remote.mediaPaths[sha] ?: "$MEDIA_DIR/$sha.jpg"
+            val file = client.getFile(remotePath)
+                ?: error("A photo referenced by the inventory is missing from GitHub: $sha")
+            require(sha256Hex(file.bytes) == sha) { "A GitHub photo failed SHA-256 validation." }
+            File(stagingDir, "$sha.jpg").apply { writeBytes(file.bytes) }
+        }
+        val tempTarget = File(importDir, ".${target.name}.${UUID.randomUUID()}.tmp")
+        try {
+            staged.copyTo(tempTarget, overwrite = true)
+            if (target.exists()) target.delete()
+            if (!tempTarget.renameTo(target)) {
+                tempTarget.copyTo(target, overwrite = true)
+                tempTarget.delete()
+            }
+        } finally {
+            tempTarget.delete()
+        }
+        require(cachedFileSha(target) == sha) { "A downloaded photo could not be stored safely on this device." }
+        return target.absolutePath
+    }
+
+    private fun logicalObject(root: JSONObject): JSONObject = JSONObject()
+        .put("boxes", root.optJSONArray("boxes") ?: JSONArray())
+        .put("items", root.optJSONArray("items") ?: JSONArray())
+        .put("itemPhotos", root.optJSONArray("itemPhotos") ?: JSONArray())
+        .put("learnedRoutes", root.optJSONArray("learnedRoutes") ?: JSONArray())
+        .put("customCategories", root.optJSONArray("customCategories") ?: JSONArray())
+        .put("categoryAliases", root.optJSONArray("categoryAliases") ?: JSONArray())
+        .put("moveHistory", root.optJSONArray("moveHistory") ?: JSONArray())
+        .put("shoppingItems", root.optJSONArray("shoppingItems") ?: JSONArray())
+        .put("media", root.optJSONArray("media") ?: JSONArray())
+
+    private fun validateProtocol(json: JSONObject) {
+        require(json.optString("product") == PRODUCT) { "This GitHub repository is not an Inventory Box sync repository." }
+        require(json.optInt("protocolVersion") == PROTOCOL_VERSION) {
+            "Unsupported Inventory Box sync protocol version ${json.optInt("protocolVersion")}."
+        }
+        require(json.optInt("snapshotSchemaVersion") == SNAPSHOT_SCHEMA_VERSION) {
+            "Unsupported Inventory Box snapshot schema ${json.optInt("snapshotSchemaVersion")}."
+        }
+    }
+
+    private fun validateSnapshotEnvelope(root: JSONObject) {
+        validateProtocol(root)
+        require(root.optString("dataHash").matches(SHA_REGEX)) { "Inventory Box snapshot has an invalid dataHash." }
+    }
+
+    private fun recordSuccess(dataHash: String, commit: String) {
+        val now = System.currentTimeMillis()
+        prefs.edit()
+            .putString(KEY_LAST_HASH, dataHash)
+            .putString(KEY_LAST_COMMIT, commit)
+            .putLong(KEY_LAST_SUCCESS, now)
+            .apply()
+    }
+
+    private fun clearAnchors() {
+        prefs.edit()
+            .remove(KEY_LAST_HASH)
+            .remove(KEY_LAST_COMMIT)
+            .remove(KEY_LAST_SUCCESS)
+            .apply()
+    }
+
+    private fun currentConfig(): SyncConfig? {
+        val repo = repositoryFullName()
+        if (!REPOSITORY_REGEX.matches(repo)) return null
+        return SyncConfig(repo, branch())
+    }
+
+    private fun currentState(
+        phase: SyncPhase,
+        message: String,
+        localChanged: Boolean = false,
+        remoteChanged: Boolean = false,
+        remoteSnapshotAvailable: Boolean = false,
+        commit: String = prefs.getString(KEY_LAST_COMMIT, "").orEmpty()
+    ) = SyncUiState(
+        phase = phase,
+        repositoryFullName = repositoryFullName(),
+        branch = branch(),
+        hasToken = tokenStore.hasToken(),
+        lastSuccessAt = prefs.getLong(KEY_LAST_SUCCESS, 0L),
+        lastRemoteCommit = commit,
+        localChanged = localChanged,
+        remoteChanged = remoteChanged,
+        remoteSnapshotAvailable = remoteSnapshotAvailable,
+        message = message
+    )
+
+    private fun loadInitialState(): SyncUiState {
+        val repo = repositoryFullName()
+        val token = tokenStore.hasToken()
+        val configured = REPOSITORY_REGEX.matches(repo) && token
+        return SyncUiState(
+            phase = if (configured) SyncPhase.READY else SyncPhase.UNCONFIGURED,
+            repositoryFullName = repo,
+            branch = branch(),
+            hasToken = token,
+            lastSuccessAt = prefs.getLong(KEY_LAST_SUCCESS, 0L),
+            lastRemoteCommit = prefs.getString(KEY_LAST_COMMIT, "").orEmpty(),
+            message = if (configured) "GitHub sync is ready." else "GitHub sync is not configured."
+        )
+    }
+
+    private fun deviceId(): String {
+        prefs.getString(KEY_DEVICE_ID, null)?.takeIf { it.isNotBlank() }?.let { return it }
+        val id = UUID.randomUUID().toString()
+        prefs.edit().putString(KEY_DEVICE_ID, id).apply()
+        return id
+    }
+
+    private fun detectImageType(file: File): Pair<String, String> {
+        val header = ByteArray(12)
+        val count = runCatching { file.inputStream().use { it.read(header) } }.getOrDefault(0)
+        if (count >= 3 &&
+            header[0] == 0xFF.toByte() && header[1] == 0xD8.toByte() && header[2] == 0xFF.toByte()) {
+            return "image/jpeg" to "jpg"
+        }
+        if (count >= 8 &&
+            header[0] == 0x89.toByte() && header[1] == 0x50.toByte() && header[2] == 0x4E.toByte() && header[3] == 0x47.toByte()) {
+            return "image/png" to "png"
+        }
+        if (count >= 12 &&
+            String(header, 0, 4, Charsets.US_ASCII) == "RIFF" &&
+            String(header, 8, 4, Charsets.US_ASCII) == "WEBP") {
+            return "image/webp" to "webp"
+        }
+        if (count >= 6) {
+            val gif = String(header, 0, 6, Charsets.US_ASCII)
+            if (gif == "GIF87a" || gif == "GIF89a") return "image/gif" to "gif"
+        }
+        return "application/octet-stream" to "bin"
+    }
+
+    private fun cachedFileSha(file: File): String {
+        val key = "media_hash_${sha256Hex(file.absolutePath.toByteArray(Charsets.UTF_8)).take(24)}"
+        val cached = prefs.getString(key, null)?.split('|')
+        if (cached?.size == 3 &&
+            cached[0].toLongOrNull() == file.length() &&
+            cached[1].toLongOrNull() == file.lastModified() &&
+            cached[2].matches(SHA_REGEX)
+        ) return cached[2]
+        val sha = file.inputStream().use { input ->
+            val digest = MessageDigest.getInstance("SHA-256")
+            val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+            while (true) {
+                val read = input.read(buffer)
+                if (read <= 0) break
+                digest.update(buffer, 0, read)
+            }
+            digest.digest().toHex()
+        }
+        prefs.edit().putString(key, "${file.length()}|${file.lastModified()}|$sha").apply()
+        return sha
+    }
+
+    private fun canonicalJson(value: Any?): String = when (value) {
+        null, JSONObject.NULL -> "null"
+        is JSONObject -> {
+            val keys = buildList {
+                val iterator = value.keys()
+                while (iterator.hasNext()) add(iterator.next())
+            }.sorted()
+            keys.joinToString(prefix = "{", postfix = "}") { key ->
+                JSONObject.quote(key) + ":" + canonicalJson(value.get(key))
+            }
+        }
+        is JSONArray -> (0 until value.length()).joinToString(prefix = "[", postfix = "]") { index ->
+            canonicalJson(value.get(index))
+        }
+        is String -> JSONObject.quote(value)
+        is Boolean -> value.toString()
+        is Number -> value.toString()
+        else -> JSONObject.quote(value.toString())
+    }
+
+    private fun safeErrorMessage(error: Throwable): String = when (error) {
+        is GitHubApiException -> when (error.statusCode) {
+            401 -> "GitHub rejected the token. Check the saved token and try again."
+            403 -> "GitHub denied access. The token needs access to this repository and Contents read/write permission."
+            404 -> "GitHub could not find that repository, branch, or file. Check the repository name and token access."
+            409 -> "GitHub could not update the repository because it changed during sync. Run Sync now again."
+            422 -> "GitHub rejected the update. The repository may have changed during sync; run Sync now again."
+            else -> error.message ?: "GitHub sync failed."
+        }
+        else -> error.message?.takeIf { it.isNotBlank() } ?: "GitHub sync failed."
+    }
+
+    private fun normalize(value: String) = value.trim().lowercase().replace(Regex("\\s+"), " ")
+
+    private fun JSONObject.putNullable(key: String, value: Int?): JSONObject =
+        put(key, value ?: JSONObject.NULL)
+
+    private fun JSONObject.optNullableInt(key: String): Int? =
+        if (!has(key) || isNull(key)) null else optInt(key)
+
+    private fun sha256Hex(bytes: ByteArray): String =
+        MessageDigest.getInstance("SHA-256").digest(bytes).toHex()
+
+    private fun ByteArray.toHex(): String = joinToString("") { "%02x".format(it) }
+
+    private companion object {
+        const val PREFS = "box_inventory_sync"
+        const val KEY_REPOSITORY = "repository"
+        const val KEY_BRANCH = "branch"
+        const val KEY_DEVICE_ID = "device_id"
+        const val KEY_LAST_HASH = "last_data_hash"
+        const val KEY_LAST_COMMIT = "last_remote_commit"
+        const val KEY_LAST_SUCCESS = "last_success"
+        const val DEFAULT_BRANCH = "main"
+        const val PRODUCT = "Inventory Box"
+        const val PROTOCOL_VERSION = 1
+        const val SNAPSHOT_SCHEMA_VERSION = 1
+        const val PROTOCOL_PATH = "inventory-sync/protocol.json"
+        const val SNAPSHOT_PATH = "inventory-sync/current/snapshot.json"
+        const val MEDIA_DIR = "inventory-sync/media"
+        const val MAX_SYNC_MEDIA_BYTES = 50L * 1024L * 1024L
+        val REPOSITORY_REGEX = Regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
+        val SHA_REGEX = Regex("^[a-f0-9]{64}$")
+    }
+}
